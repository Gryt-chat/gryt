# Per-machine settings for gryt-update-feed.service.
# Install to /etc/default/gryt-update-feed. Every line is optional, and on the
# deployment this was written for none of them are needed.

# Channels to mirror, space separated. "stable" is releases with no prerelease
# part; "beta" is whichever of the two is newer, which is what a client with
# beta releases turned on expects.
#GRYT_UPDATE_CHANNELS=stable beta

# The repository releases are published to. Note that this is the superproject,
# not the client — release-client.yml lives there.
#GRYT_UPDATE_REPO=Gryt-chat/gryt

# Where the channels are written. The default is downloads/updates inside the
# checkout, which is the directory ops/internal/docker-compose.yml already
# mounts into the site's nginx at /usr/share/nginx/html/downloads.
#GRYT_UPDATE_DIR=/path/to/gryt/ops/internal/downloads/updates

# Where the release last mirrored is remembered, one file per channel. Has to
# be writable by whoever the unit runs as.
#GRYT_UPDATE_STATE=/var/lib/gryt-update-feed

# Refuse to download below this much free disk on the filesystem holding
# GRYT_UPDATE_DIR. The Keycloak database is on the same disk.
#GRYT_MIN_FREE_GB=10

# Optional. Only raises the GitHub API rate limit, which one machine asking
# twice every ten minutes is nowhere near. The mirror reads public releases and
# the token needs no scopes.
#GITHUB_TOKEN=
