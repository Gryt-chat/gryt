##
## ops/.env  —  Local dev overrides for start_dev.sh
##
## Copy this file to ops/.env and edit as needed.
## Every variable here has a sane default in start_dev.sh, so you only
## need to set the ones you want to change.
##

# ── Dev dependency toggles ────────────────────────────────────────────
# Set to 0 to skip starting local MinIO container
# DEV_WITH_S3=1

# ── Local auth ────────────────────────────────────────────────────────
# Dev runs its own Keycloak and identity CA, so accounts here are
# throwaway and nothing depends on production being up. Set to 0 to
# authenticate against auth.gryt.chat instead — real accounts, real
# identities. Falls back to that automatically if Docker is not running.
# DEV_WITH_AUTH=1
# KEYCLOAK_PORT=18080
# IDENTITY_PORT=18081
# KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# ── SFU ───────────────────────────────────────────────────────────────
# SFU_WS_HOST=ws://127.0.0.1:5005
# SFU_PUBLIC_HOST=wss://sfu.example.com
# Multiple SFU URLs (comma-separated) for LAN + public access:
# SFU_PUBLIC_HOST=wss://sfu.example.com,ws://192.168.1.100:5005
# STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Public IP(s) the SFU advertises in ICE candidates (required when behind NAT /
# Cloudflare Tunnel so clients know where to send UDP media).
# Comma-separated for multi-network (e.g. public + LAN):
# ICE_ADVERTISE_IP=203.0.113.10
# ICE_ADVERTISE_IP=203.0.113.10,192.168.1.100

# ── Server ────────────────────────────────────────────────────────────
# CORS_ORIGIN=http://127.0.0.1:15738,http://localhost:3666,https://app.gryt.chat,https://gryt.example.com
# SERVER_PASSWORD=changeme  # optional server↔SFU shared secret (NOT a user join password)

# ── Auth / OIDC ───────────────────────────────────────────────────────
# GRYT_AUTH_MODE=required
# Which identities the dev servers admit. Add "local" to exercise joining with
# no account at all — the client's "Continue without an account" path.
# GRYT_IDENTITY_TIERS=account,local
# GRYT_OIDC_ISSUER=https://auth.gryt.chat/realms/gryt
# GRYT_OIDC_AUDIENCE=gryt-web
# JWT_SECRET=dev-secret-do-not-use-in-production

# ── MinIO / S3 ────────────────────────────────────────────────────────
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# S3_BUCKET=gryt
