# Per-machine settings for gryt-auto-update.service.
# Install to /etc/default/gryt-auto-update. Every line is optional, and on a
# plain `docker compose -f prod.yml up -d` deployment none of them are needed
# — the script auto-detects the running gryt-*-server containers and reads
# each stack's compose files, their order and its env file off the running
# container's own labels.

# Stacks to refresh, space separated. Leave unset to auto-detect every running
# gryt-<stack>-server container. Set to an empty string to refresh no stacks
# at all — for a deployment that manages everything through GRYT_CONTAINERS.
#GRYT_STACKS=prod

# Services to refresh on each stack, space separated. Default matches every
# released service in ops/deploy/compose/{prod,beta}.yml.
#
# The SFU is special: it is only recreated when nobody is in voice on that
# stack, because recreating it drops calls. Everything else updates as soon as
# a new image lands, since a server restart does not interrupt a call in
# progress — clients reconnect through session:restore.
#GRYT_SERVICES=sfu server image-worker client

# Narrow it to one service, the old spelling. GRYT_SERVICES wins if both are set.
#GRYT_SERVICE=server

# Containers to refresh by name, space separated, for anything that is not
# gryt-<stack>-<service> — a gryt CLI managed server, for instance.
#GRYT_CONTAINERS=

# Compose profiles to enable, space separated. Needed only if you run `client`
# from ops/deploy/compose (it sits behind the `web` profile) or another
# profile-gated service.
#GRYT_PROFILES=web

# Refuse to pull below this much free disk on the stack's filesystem, in
# gigabytes.
#GRYT_MIN_FREE_GB=10
